# Retell AI
RETELL_API_KEY=
RETELL_AGENT_ID=
RETELL_PHONE_NUMBER=

# ElevenLabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Google Gemini
GOOGLE_AI_API_KEY=

# Shopify
SHOPIFY_SHOP_DOMAIN=           # tu-tienda.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_WEBHOOK_SECRET=

# Shopify por tienda para Finanzas multi-tienda
# Costa Rica usa SHOPIFY_SHOP_DOMAIN/SHOPIFY_ACCESS_TOKEN como fallback.
SHOPIFY_CR_SHOP_DOMAIN=
SHOPIFY_CR_CLIENT_ID=
SHOPIFY_CR_CLIENT_SECRET=
SHOPIFY_CR_ACCESS_TOKEN=
SHOPIFY_HN_SHOP_DOMAIN=
SHOPIFY_HN_CLIENT_ID=
SHOPIFY_HN_CLIENT_SECRET=
SHOPIFY_HN_ACCESS_TOKEN=

# Nuevas tiendas:
# 1. Crear fila en stores.
# 2. Crear store_integrations.secret_env_refs apuntando a variables como:
#    SHOPIFY_<CODIGO>_SHOP_DOMAIN / SHOPIFY_<CODIGO>_ACCESS_TOKEN.
# 3. Definir courier_accounts y courier_file_profiles para sus couriers.

# Supabase
SUPABASE_URL=                  # https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=     # service_role secret (no la anon key)

# iComfly (Estado de despacho)
ICOMFLY_BASE=                  # default https://api.icomfly.com/api
ICOMFLY_STORE_ID=              # legacy CR: id externo de tienda iComfly (default 71)
ICOMFLY_CR_STORE_ID=           # Costa Rica: id externo de tienda iComfly (= 71)
ICOMFLY_HN_STORE_ID=           # Honduras: id externo de tienda iComfly (= 90)
# Nota (modulo de Leads): /api/chat/* se autentica SOLO con login por
# credenciales (ICOMFLY_EMAIL/ICOMFLY_PASSWORD); una sola cuenta cubre ambas
# tiendas via el header X-Active-Store-Ids. El ICOMFLY_TOKEN estatico (ik_live_)
# es read-only para /orders y NO tiene alcance a los chats.
ICOMFLY_TOKEN=                 # token bearer opcional (solo /orders); login tiene prioridad
ICOMFLY_EMAIL=                 # correo para POST /auth/login
ICOMFLY_PASSWORD=              # password para POST /auth/login

# App
NEXT_PUBLIC_APP_URL=
APP_SECRET=                    # clave random para proteger el trigger manual
NEXT_PUBLIC_APP_SECRET=        # igual que APP_SECRET (necesaria para el dashboard)
AUTH_SECRET=                   # clave random para firmar la cookie de login
ADMIN_PASSWORD=                # password del panel

# Leads (modulo WhatsApp)
NEXT_PUBLIC_CATALOG_URL_CR=    # link del catalogo que copian las asesoras (CR); sin valor el boton se oculta
NEXT_PUBLIC_CATALOG_URL_HN=    # link del catalogo (HN)
LEADS_MEDIA_ALLOWED_HOSTS=     # hosts extra permitidos para el proxy de media del chat (coma-separado, ej: cdn.ejemplo.com,.s3.amazonaws.com)
