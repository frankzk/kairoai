# Supabase
SUPABASE_URL=                  # https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=     # service_role secret (no la anon key)

# App
NEXT_PUBLIC_APP_URL=
APP_SECRET=                    # clave random para proteger el trigger manual
NEXT_PUBLIC_APP_SECRET=        # igual que APP_SECRET (necesaria para el dashboard)
AUTH_SECRET=                   # clave random para firmar la cookie de login
ADMIN_PASSWORD=                # password del panel
